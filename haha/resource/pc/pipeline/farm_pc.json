{
    // ======================================================================
    // 端游传奇类挂机覆盖：吃药用快捷键，移动用鼠标右键按住。
    // ======================================================================

    // 吃药：按 F1（药品快捷栏）。动作类型改为 ClickKey
    "挂机_吃药": {
        "action": "ClickKey",
        "key": 112
    },

    // 换位置：在角色上方按住右键 1.5 秒（传奇类端游右键按住为跑步）
    // 动作类型从 Swipe 改为 LongPress，target / duration / contact 都要写
    "挂机_换位置": {
        "action": "LongPress",
        "target": [560, 160, 160, 80],
        "duration": 1500,
        "contact": 1
    }
}
