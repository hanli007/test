{
    // ======================================================================
    // 端游覆盖层（在 resource/base 之后加载，只写与手游不同的部分）。
    //
    // MAA 多资源叠加规则（已实测 maafw 5.16）：
    //   · 同名节点按字段合并：只写需要改的字段，其余沿用 base
    //   · 但如果改了 recognition / action 的“类型”，该类型的旧参数会全部丢弃，
    //     必须把新类型需要的参数写全（例如 Click 改成 LongPress 时要重写 target）
    //   · 图片：resource/pc/image/ 下同路径的图片会覆盖 base 的，
    //     所以端游界面截图按相同文件名放到 resource/pc/image/ 即可
    //
    // Win32 虚拟键码（ClickKey / KeyDown 的 key）：
    //   ESC=27  Tab=9  Enter=13  Space=32  F1~F12=112~123  数字 0~9=48~57  A~Z=65~90
    //   Alt=18  Ctrl=17  Shift=16  方向键 左37 上38 右39 下40
    // Win32 的 contact：0=左键 1=右键 2=中键
    // ======================================================================

    // 端游由程序按 exe_path 启动（core/pc_client.py），这里不需要 StartApp
    "通用_启动游戏": {
        "action": "DoNothing"
    },

    // 端游二级界面一般用 ESC 关闭。改了动作类型，所以识别参数沿用 base（返回按钮模板），动作参数重写
    "通用_返回按钮": {
        "action": "ClickKey",
        "key": 27
    }
}
