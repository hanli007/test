{
    // ======================================================================
    // 端游回合制战斗覆盖：端游通常用快捷键出招，比手游点按钮更稳。
    // 快捷键请按游戏内实际设置修改。
    // ======================================================================

    // 选择技能：手游是找技能图标点击，端游改为按 F1（技能栏第 1 格）
    // 识别类型从 TemplateMatch 改为 DirectHit，动作从 Click 改为 ClickKey，参数需写全
    "战斗_选择技能": {
        "recognition": "DirectHit",
        "action": "ClickKey",
        "key": 112,
        "timeout": 5000,
        "next": ["战斗_选择目标"],
        "on_error": ["战斗_循环"]
    }
}
