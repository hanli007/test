{
    // ======================================================================
    // 师门任务（梦幻西游 / 问道类单人日常）。
    // 结构：典型“状态机”写法 —— 一个循环节点（师门_循环）列出所有可能的界面状态，
    //       每个状态节点处理完后回到循环节点，直到识别到“已完成”。
    // 入口：师门_开始（在 config.yaml 的 tasks.师门.entry 中引用）
    // ======================================================================

    "师门_开始": {
        "next": ["师门_循环"],
        "on_error": ["[JumpBack]通用_回到主界面"]
    },

    // 循环节点：顺序很重要，越“确定”的状态越靠前
    "师门_循环": {
        "timeout": 90000,           // 90 秒内识别不到任何已知状态 → on_error
        "next": [
            "师门_已完成",
            "[JumpBack]战斗_入口",
            "师门_对话选项",
            "师门_上交物品",
            "师门_购买物品",
            "师门_寻路中",
            "师门_追踪栏",
            "[JumpBack]通用_确认",
            "[JumpBack]通用_关闭弹窗",
            "师门_打开活动"
        ],
        "on_error": ["[JumpBack]通用_回到主界面"]
    },

    // ---------- 结束条件 ----------
    // 任务追踪栏出现“师门 20/20”或“已完成”
    "师门_已完成": {
        "recognition": "OCR",
        "roi": [980, 160, 300, 260],
        "expected": ["师门.*(20/20|已完成)"],
        "action": "Custom",
        "custom_action": "SaveKv",
        "custom_action_param": {"key": "师门状态", "value": "已完成"}
    },

    // ---------- 任务追踪栏 ----------
    // 识别右侧追踪栏中的师门条目，先记录进度，再点击它触发自动寻路
    "师门_追踪栏": {
        "recognition": "OCR",
        "roi": [980, 160, 300, 260],
        "expected": ["师门.*\\d+/\\d+"],
        "action": "Custom",
        "custom_action": "SaveProgress",
        "custom_action_param": {"key": "师门进度"},
        "next": ["师门_点击追踪栏"]
    },
    "师门_点击追踪栏": {
        "action": "Click",
        "target": "师门_追踪栏",    // 点击上一个节点识别到的位置
        "post_delay": 2000,
        "next": ["师门_循环"]
    },

    // 正在自动寻路（屏幕中央的“自动寻路中”字样），等待即可
    "师门_寻路中": {
        "recognition": "OCR",
        "roi": [440, 420, 400, 80],
        "expected": ["寻路中"],
        "post_delay": 2000,
        "next": ["师门_循环"]
    },

    // ---------- NPC 对话 ----------
    // 对话框中的可选项，按优先级排列
    "师门_对话选项": {
        "recognition": "OCR",
        "roi": [700, 260, 580, 360],
        "expected": ["师门任务", "领取任务", "交付", "我来帮你", "好的"],
        "order_by": "Expected",     // 按 expected 的先后顺序优先
        "action": "Click",
        "next": ["师门_循环"]
    },

    // ---------- 物品类任务 ----------
    "师门_上交物品": {
        "recognition": "OCR",
        "expected": ["^上交$", "^给予$"],
        "action": "Click",
        "next": ["师门_循环"]
    },
    "师门_购买物品": {
        "recognition": "OCR",
        "expected": ["^购买$", "^购买并上交$"],
        "action": "Click",
        "next": ["[JumpBack]通用_确认", "师门_循环"]
    },

    // ---------- 领取任务 ----------
    // 追踪栏没有师门时：打开活动面板 → 找到师门 → 点“参加”
    "师门_打开活动": {
        "recognition": "TemplateMatch",
        "template": "shimen/活动按钮.png",
        "roi": [960, 0, 320, 160],
        "action": "Click",
        "next": ["师门_活动面板_参加"]
    },
    "师门_活动面板_参加": {
        "recognition": "OCR",
        "expected": ["师门"],
        "action": "Click",
        "target_offset": [380, 0, 0, 0],   // “参加”按钮通常在活动名称右侧，按实际界面调整
        "timeout": 5000,
        "next": ["师门_循环"],
        "on_error": ["[JumpBack]通用_关闭弹窗"]
    }
}
