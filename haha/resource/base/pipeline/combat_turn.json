{
    // ======================================================================
    // 回合制战斗（梦幻西游 / 问道类）：可复用的战斗子流程。
    // 用法：在任务的循环节点 next 中加入 "[JumpBack]战斗_入口"，
    //       识别到进入战斗 → 执行战斗循环 → 战斗结束后自动回到原任务。
    // 策略：优先开启游戏自带的“自动战斗”；没有自动按钮时，手动选技能 + 选目标。
    // ======================================================================

    // 进入战斗的标识：战斗界面特有的元素（如右下角“法术/道具/防御”按钮栏）
    "战斗_入口": {
        "recognition": "TemplateMatch",
        "template": "combat/战斗标识.png",
        "roi": [880, 480, 400, 240],
        "next": ["战斗_循环"]
    },

    // 战斗主循环：每轮判断战斗是否结束 / 是否轮到我方操作
    "战斗_循环": {
        "timeout": 180000,          // 一场战斗 3 分钟还没结束视为异常
        "next": [
            "战斗_结束",
            "战斗_开启自动",
            "战斗_使用技能"
        ],
        "on_error": ["[JumpBack]通用_关闭弹窗"]
    },

    // 战斗结束：战斗标识消失（inverse 反转识别结果）
    "战斗_结束": {
        "recognition": "TemplateMatch",
        "template": "combat/战斗标识.png",
        "roi": [880, 480, 400, 240],
        "inverse": true,
        "post_delay": 1000
    },

    // 自动战斗按钮（处于“未开启”状态的样子）。开启后此节点不再命中。
    "战斗_开启自动": {
        "recognition": "TemplateMatch",
        "template": "combat/自动未开启.png",
        "action": "Click",
        "next": ["战斗_循环"]
    },

    // ---------- 手动出招（没有自动战斗时） ----------
    // 轮到我方：出现“法术”按钮
    "战斗_使用技能": {
        "recognition": "TemplateMatch",
        "template": "combat/法术按钮.png",
        "action": "Click",
        "next": ["战斗_选择技能"]
    },

    // 选择技能：按模板找技能图标；可通过 pipeline_override 按账号替换成不同门派技能
    "战斗_选择技能": {
        "recognition": "TemplateMatch",
        "template": "combat/技能1.png",
        "action": "Click",
        "timeout": 5000,
        "next": ["战斗_选择目标"],
        "on_error": ["战斗_循环"]
    },

    // 选择目标：默认点击敌方站位区域（左上半区）的固定位置
    "战斗_选择目标": {
        "action": "Click",
        "target": [260, 220, 120, 120],
        "next": ["战斗_循环"]
    }
}
