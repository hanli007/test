{
    // ======================================================================
    // 通用节点：启动游戏、回到主界面、关闭弹窗、断线重连、登录。
    // 其他任务通过 "[JumpBack]通用_xxx" 引用，处理完后自动回到原任务继续。
    // 坐标均为 1280x720；模板图放在 image/common/ 下，需自行截图替换占位图。
    // ======================================================================

    // ---------- 启动游戏 ----------
    // package 由程序按账号配置自动注入（见 core/worker.py 中的 _base_override）
    "通用_启动游戏": {
        "action": "StartApp",
        "package": "",
        "post_delay": 5000,
        "next": ["通用_回到主界面"]
    },

    // ---------- 回到主界面（状态机入口） ----------
    // 不断识别当前界面，遇到弹窗就关、遇到登录就点，直到看到主界面标识为止。
    "通用_回到主界面": {
        "timeout": 60000,
        "next": [
            "通用_主界面",
            "[JumpBack]通用_断线重连",
            "[JumpBack]通用_登录",
            "[JumpBack]通用_关闭弹窗",
            "[JumpBack]通用_返回按钮"
        ]
    },

    // 主界面标识：选一个只在主界面出现、位置固定的图标（如右上角的“活动”或小地图边框）
    "通用_主界面": {
        "recognition": "TemplateMatch",
        "template": "common/主界面标识.png",
        "roi": [960, 0, 320, 160]
    },

    // 通用关闭按钮（弹窗右上角的 X）。可放多张不同样式的 X 到 common/关闭按钮/ 文件夹
    "通用_关闭弹窗": {
        "recognition": "TemplateMatch",
        "template": "common/关闭按钮",
        "action": "Click"
    },

    // 二级界面左上角的“返回”箭头
    "通用_返回按钮": {
        "recognition": "TemplateMatch",
        "template": "common/返回按钮.png",
        "roi": [0, 0, 200, 120],
        "action": "Click"
    },

    // 断线提示框
    "通用_断线重连": {
        "recognition": "OCR",
        "expected": ["重新连接", "重连", "网络.*断开"],
        "roi": [320, 200, 640, 320],
        "action": "Click",
        "post_delay": 5000
    },

    // 登录 / 选服界面
    "通用_登录": {
        "recognition": "OCR",
        "expected": ["进入游戏", "开始游戏", "登录游戏"],
        "action": "Click",
        "post_delay": 8000
    },

    // ---------- 通用：确认对话框 ----------
    "通用_确认": {
        "recognition": "OCR",
        "expected": ["^确定$", "^确认$", "^是$"],
        "action": "Click"
    }
}
